---
import BaseLayout from '../layouts/BaseLayout.astro';
import initialPlan from '../data/plan.json';

// Escape `</script>` defensively when serializing initial JSON payload
const serializedPlan = JSON.stringify(initialPlan).replace(/</g, '\\u003c');
---

<BaseLayout
  title="Plan"
  description="Near-term checklist, study priorities, and future milestones — read-only for visitors, directly editable by owner via GitHub authentication."
>
  <header class="page-header plan-page-header">
    <div class="plan-header-row">
      <div>
        <div class="eyebrow">
          <span>PLAN & CHECKLIST</span>
          <span>·</span>
          <span>UPDATED <span id="plan-updated-at">{initialPlan.updatedAt}</span></span>
        </div>
        <h1 class="page-title">Current & Future Plan</h1>
        <p class="page-lead">
          Actionable checklists and upcoming milestones without artificial progress bars.
        </p>
      </div>

      <div class="owner-controls">
        <button id="unlock-btn" type="button" class="owner-btn" title="Owner edit mode (GitHub Token)">
          <svg
            width="14"
            height="14"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <rect width="18" height="11" x="3" y="11" rx="2" ry="2"></rect>
            <path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
          </svg>
          <span>Edit Plan</span>
        </button>
      </div>
    </div>
  </header>

  <!-- Sticky Owner Edit Toolbar (shown only when authenticated in Edit Mode) -->
  <div id="editor-toolbar" class="editor-toolbar card" hidden>
    <div class="toolbar-left">
      <span id="editor-status-dot" class="editor-dot"></span>
      <span id="editor-status-text" class="editor-status">Edit Mode Unlocked</span>
    </div>
    <div class="toolbar-actions">
      <button id="add-section-btn" type="button" class="tool-btn">+ Section</button>
      <button id="discard-btn" type="button" class="tool-btn" hidden>Discard</button>
      <button id="save-github-btn" type="button" class="tool-btn tool-btn-primary">
        Save to GitHub
      </button>
      <button id="exit-edit-btn" type="button" class="tool-btn">Done</button>
      <button id="forget-token-btn" type="button" class="tool-btn tool-btn-danger" title="Remove saved token from this browser">
        Forget Token
      </button>
    </div>
  </div>

  <!-- Current Focus Note -->
  <section class="focus-banner card">
    <div class="focus-banner-label">CURRENT FOCUS</div>
    <p id="focus-note-view" class="focus-note-text">{initialPlan.focusNote}</p>
    <textarea
      id="focus-note-input"
      class="focus-note-textarea"
      rows="3"
      hidden
      placeholder="Write your current focus or monthly theme..."
    ></textarea>
  </section>

  <!-- Filter Bar (Read Mode) -->
  <div id="filter-bar" class="controls-bar" style="margin-top: 2rem;">
    <div class="filter-tabs" role="tablist" aria-label="Filter plan items">
      <button class="filter-btn active" data-filter="all" type="button">All</button>
      <button class="filter-btn" data-filter="todo" type="button">To Do</button>
      <button class="filter-btn" data-filter="done" type="button">Completed</button>
    </div>
  </div>

  <!-- Plan Sections Container -->
  <div id="plan-sections" class="plan-stack"></div>

  <p id="plan-empty" class="empty-state" hidden>
    No plan items match this filter.
  </p>

  <!-- GitHub Token Auth Modal -->
  <div id="auth-modal" class="auth-modal" hidden role="dialog" aria-modal="true" aria-labelledby="auth-modal-title">
    <div class="auth-dialog card">
      <div class="auth-dialog-head">
        <h2 id="auth-modal-title">Unlock Owner Edit Mode</h2>
        <button type="button" id="auth-close-btn" class="icon-close" aria-label="Close">✕</button>
      </div>
      <p class="auth-desc">
        This site runs on static GitHub Pages. To edit directly in the browser while keeping the page
        strictly read-only for visitors, enter a GitHub
        <a href="https://github.com/settings/personal-access-tokens/new" target="_blank" rel="noreferrer">
          Fine-grained Personal Access Token ↗
        </a>
        scoped only to <code>feuclain/feuclain.github.io</code>:
      </p>
      <ol class="auth-steps">
        <li><strong>Repository access</strong> → <em>Only select repositories</em> → <code>feuclain/feuclain.github.io</code></li>
        <li><strong>Permissions</strong> → <em>Repository permissions</em> → <strong>Contents: Read and write</strong></li>
        <li>Paste the token below (stored <strong>only</strong> in this browser's <code>localStorage</code>).</li>
      </ol>
      <form id="auth-form">
        <input
          id="token-input"
          type="password"
          class="token-input"
          placeholder="github_pat_..."
          autocomplete="off"
          required
        />
        <p id="auth-error" class="auth-error" hidden></p>
        <div class="auth-actions">
          <button type="button" id="auth-cancel-btn" class="tool-btn">Cancel</button>
          <button type="submit" id="auth-submit-btn" class="tool-btn tool-btn-primary">
            Verify & Unlock
          </button>
        </div>
      </form>
    </div>
  </div>

  <script id="initial-plan-data" type="application/json" set:html={serializedPlan} />

  <script is:inline>
    (() => {
      const REPO_OWNER = 'feuclain';
      const REPO_NAME = 'feuclain.github.io';
      const FILE_PATH = 'src/data/plan.json';
      const BRANCH = 'main';
      const TOKEN_KEY = 'feuclain_plan_gh_token';

      const initialEl = document.getElementById('initial-plan-data');
      let committedPlan = JSON.parse(initialEl ? initialEl.textContent : '{}');
      let workingPlan = structuredClone(committedPlan);
      let fileSha = null;

      let isEditing = false;
      let isDirty = false;
      let activeFilter = 'all';

      // DOM elements
      const updatedAtEl = document.getElementById('plan-updated-at');
      const unlockBtn = document.getElementById('unlock-btn');
      const toolbar = document.getElementById('editor-toolbar');
      const statusDot = document.getElementById('editor-status-dot');
      const statusText = document.getElementById('editor-status-text');
      const addSectionBtn = document.getElementById('add-section-btn');
      const discardBtn = document.getElementById('discard-btn');
      const saveBtn = document.getElementById('save-github-btn');
      const exitEditBtn = document.getElementById('exit-edit-btn');
      const forgetTokenBtn = document.getElementById('forget-token-btn');

      const focusView = document.getElementById('focus-note-view');
      const focusInput = document.getElementById('focus-note-input');
      const filterBar = document.getElementById('filter-bar');
      const sectionsEl = document.getElementById('plan-sections');
      const emptyEl = document.getElementById('plan-empty');

      const authModal = document.getElementById('auth-modal');
      const authForm = document.getElementById('auth-form');
      const tokenInput = document.getElementById('token-input');
      const authError = document.getElementById('auth-error');
      const authSubmitBtn = document.getElementById('auth-submit-btn');
      const authCloseBtn = document.getElementById('auth-close-btn');
      const authCancelBtn = document.getElementById('auth-cancel-btn');

      function encodeUtf8Base64(str) {
        const bytes = new TextEncoder().encode(str);
        let binary = '';
        for (let i = 0; i < bytes.length; i++) {
          binary += String.fromCharCode(bytes[i]);
        }
        return btoa(binary);
      }

      function decodeUtf8Base64(b64) {
        const clean = b64.replace(/\s/g, '');
        const binary = atob(clean);
        const bytes = new Uint8Array(binary.length);
        for (let i = 0; i < binary.length; i++) {
          bytes[i] = binary.charCodeAt(i);
        }
        return new TextDecoder('utf-8').decode(bytes);
      }

      function uid(prefix) {
        return `${prefix}-${Date.now().toString(36)}-${Math.random().toString(36).slice(2, 6)}`;
      }

      function markDirty(dirty = true) {
        isDirty = dirty;
        if (!isEditing) return;
        if (discardBtn) discardBtn.hidden = !dirty;
        if (dirty) {
          statusDot.className = 'editor-dot dot-dirty';
          statusText.textContent = 'Unsaved changes (Ctrl/Cmd+S to save)';
        } else {
          statusDot.className = 'editor-dot dot-clean';
          statusText.textContent = 'Edit Mode Unlocked';
        }
      }

      function setStatus(kind, message) {
        statusDot.className = `editor-dot dot-${kind}`;
        statusText.textContent = message;
      }

      function createEl(tag, className, text) {
        const el = document.createElement(tag);
        if (className) el.className = className;
        if (text !== undefined) el.textContent = text;
        return el;
      }

      function render() {
        const data = isEditing ? workingPlan : committedPlan;
        if (updatedAtEl) updatedAtEl.textContent = data.updatedAt || '';

        if (isEditing) {
          unlockBtn.hidden = true;
          toolbar.hidden = false;
          filterBar.hidden = true;
          focusView.hidden = true;
          focusInput.hidden = false;
          focusInput.value = data.focusNote || '';
        } else {
          unlockBtn.hidden = false;
          toolbar.hidden = true;
          filterBar.hidden = false;
          focusView.hidden = false;
          focusInput.hidden = true;
          focusView.textContent = data.focusNote || '';
        }

        sectionsEl.innerHTML = '';
        let visibleSections = 0;

        (data.sections || []).forEach((sec, secIdx) => {
          if (!isEditing) {
            // Read-only view
            const filteredItems = (sec.items || []).filter((item) => {
              if (activeFilter === 'todo') return !item.done;
              if (activeFilter === 'done') return !!item.done;
              return true;
            });

            if (activeFilter !== 'all' && filteredItems.length === 0) return;
            visibleSections++;

            const card = createEl('section', 'card plan-section-card');
            const head = createEl('div', 'plan-sec-head');
            const headLeft = createEl('div');
            if (sec.period) headLeft.appendChild(createEl('div', 'plan-sec-period', sec.period));
            headLeft.appendChild(createEl('h2', 'plan-sec-title', sec.title || 'Untitled Section'));
            head.appendChild(headLeft);

            const doneCount = (sec.items || []).filter((i) => i.done).length;
            const totalCount = (sec.items || []).length;
            if (totalCount > 0) {
              head.appendChild(
                createEl('span', 'plan-sec-count', `${doneCount} / ${totalCount} done`)
              );
            }
            card.appendChild(head);

            if (sec.note) {
              card.appendChild(createEl('p', 'plan-sec-note', sec.note));
            }

            const ul = createEl('ul', 'plan-item-list');
            filteredItems.forEach((item) => {
              const li = createEl('li', `plan-item-row${item.done ? ' is-done' : ''}`);
              const check = createEl(
                'span',
                `plan-check ${item.done ? 'check-done' : 'check-todo'}`,
                item.done ? '✓' : ''
              );
              check.setAttribute('aria-hidden', 'true');
              li.appendChild(check);

              const body = createEl('div', 'plan-item-body');
              const topLine = createEl('div', 'plan-item-topline');
              topLine.appendChild(createEl('span', 'plan-item-text', item.text));
              if (item.tag) {
                topLine.appendChild(createEl('span', 'tag-chip', item.tag));
              }
              body.appendChild(topLine);

              if (item.detail) {
                body.appendChild(createEl('p', 'plan-item-detail', item.detail));
              }
              li.appendChild(body);
              ul.appendChild(li);
            });

            card.appendChild(ul);
            sectionsEl.appendChild(card);
          } else {
            // Interactive Owner Edit Mode
            visibleSections++;
            const card = createEl('section', 'card plan-section-card is-editing');

            const secTopBar = createEl('div', 'edit-sec-topbar');
            const periodInput = createEl('input', 'edit-input edit-period-input');
            periodInput.type = 'text';
            periodInput.placeholder = 'PERIOD / LABEL (e.g. DEC 2026 – MAR 2027)';
            periodInput.value = sec.period || '';
            periodInput.addEventListener('input', () => {
              sec.period = periodInput.value;
              markDirty();
            });
            secTopBar.appendChild(periodInput);

            const secBtns = createEl('div', 'edit-row-btns');
            const upSec = createEl('button', 'mini-icon-btn', '↑');
            upSec.type = 'button';
            upSec.title = 'Move section up';
            upSec.disabled = secIdx === 0;
            upSec.addEventListener('click', () => {
              const arr = workingPlan.sections;
              [arr[secIdx - 1], arr[secIdx]] = [arr[secIdx], arr[secIdx - 1]];
              markDirty();
              render();
            });

            const downSec = createEl('button', 'mini-icon-btn', '↓');
            downSec.type = 'button';
            downSec.title = 'Move section down';
            downSec.disabled = secIdx === workingPlan.sections.length - 1;
            downSec.addEventListener('click', () => {
              const arr = workingPlan.sections;
              [arr[secIdx + 1], arr[secIdx]] = [arr[secIdx], arr[secIdx + 1]];
              markDirty();
              render();
            });

            const delSec = createEl('button', 'mini-icon-btn mini-danger', 'Delete Section');
            delSec.type = 'button';
            delSec.addEventListener('click', () => {
              if (!confirm(`Delete section "${sec.title || 'Untitled'}"?`)) return;
              workingPlan.sections.splice(secIdx, 1);
              markDirty();
              render();
            });

            secBtns.append(upSec, downSec, delSec);
            secTopBar.appendChild(secBtns);
            card.appendChild(secTopBar);

            const titleInput = createEl('input', 'edit-input edit-sec-title-input');
            titleInput.type = 'text';
            titleInput.placeholder = 'Section Title';
            titleInput.value = sec.title || '';
            titleInput.addEventListener('input', () => {
              sec.title = titleInput.value;
              markDirty();
            });
            card.appendChild(titleInput);

            const noteInput = createEl('input', 'edit-input edit-sec-note-input');
            noteInput.type = 'text';
            noteInput.placeholder = 'Optional section subtitle or goal...';
            noteInput.value = sec.note || '';
            noteInput.addEventListener('input', () => {
              sec.note = noteInput.value;
              markDirty();
            });
            card.appendChild(noteInput);

            const ul = createEl('ul', 'plan-item-list edit-item-list');
            (sec.items || []).forEach((item, itemIdx) => {
              const li = createEl('li', `edit-item-row${item.done ? ' is-done' : ''}`);

              const toggleBtn = createEl(
                'button',
                `plan-check plan-check-btn ${item.done ? 'check-done' : 'check-todo'}`,
                item.done ? '✓' : ''
              );
              toggleBtn.type = 'button';
              toggleBtn.title = item.done ? 'Mark as To Do' : 'Mark as Completed';
              toggleBtn.addEventListener('click', () => {
                item.done = !item.done;
                markDirty();
                render();
              });
              li.appendChild(toggleBtn);

              const fields = createEl('div', 'edit-item-fields');
              const row1 = createEl('div', 'edit-item-row1');

              const textIn = createEl('input', 'edit-input edit-item-text');
              textIn.type = 'text';
              textIn.placeholder = 'Plan item...';
              textIn.value = item.text || '';
              textIn.addEventListener('input', () => {
                item.text = textIn.value;
                markDirty();
              });

              const tagIn = createEl('input', 'edit-input edit-item-tag');
              tagIn.type = 'text';
              tagIn.placeholder = 'Tag';
              tagIn.value = item.tag || '';
              tagIn.addEventListener('input', () => {
                item.tag = tagIn.value;
                markDirty();
              });

              row1.append(textIn, tagIn);

              const detailIn = createEl('input', 'edit-input edit-item-detail');
              detailIn.type = 'text';
              detailIn.placeholder = 'Optional note / detail...';
              detailIn.value = item.detail || '';
              detailIn.addEventListener('input', () => {
                item.detail = detailIn.value;
                markDirty();
              });

              fields.append(row1, detailIn);
              li.appendChild(fields);

              const itemBtns = createEl('div', 'edit-item-actions');
              const upBtn = createEl('button', 'mini-icon-btn', '↑');
              upBtn.type = 'button';
              upBtn.disabled = itemIdx === 0;
              upBtn.addEventListener('click', () => {
                const arr = sec.items;
                [arr[itemIdx - 1], arr[itemIdx]] = [arr[itemIdx], arr[itemIdx - 1]];
                markDirty();
                render();
              });

              const downBtn = createEl('button', 'mini-icon-btn', '↓');
              downBtn.type = 'button';
              downBtn.disabled = itemIdx === sec.items.length - 1;
              downBtn.addEventListener('click', () => {
                const arr = sec.items;
                [arr[itemIdx + 1], arr[itemIdx]] = [arr[itemIdx], arr[itemIdx + 1]];
                markDirty();
                render();
              });

              const delBtn = createEl('button', 'mini-icon-btn mini-danger', '✕');
              delBtn.type = 'button';
              delBtn.title = 'Delete item';
              delBtn.addEventListener('click', () => {
                sec.items.splice(itemIdx, 1);
                markDirty();
                render();
              });

              itemBtns.append(upBtn, downBtn, delBtn);
              li.appendChild(itemBtns);
              ul.appendChild(li);
            });

            card.appendChild(ul);

            const addItemBtn = createEl('button', 'add-item-btn', '+ Add Item');
            addItemBtn.type = 'button';
            addItemBtn.addEventListener('click', () => {
              sec.items = sec.items || [];
              sec.items.push({
                id: uid('item'),
                text: '',
                detail: '',
                tag: '',
                done: false,
              });
              markDirty();
              render();
              const inputs = card.querySelectorAll('.edit-item-text');
              const last = inputs[inputs.length - 1];
              if (last) last.focus();
            });
            card.appendChild(addItemBtn);

            sectionsEl.appendChild(card);
          }
        });

        if (emptyEl) {
          emptyEl.hidden = isEditing || visibleSections > 0;
        }
      }

      focusInput?.addEventListener('input', () => {
        workingPlan.focusNote = focusInput.value;
        markDirty();
      });

      // Filter buttons in Read-Only mode
      document.querySelectorAll('#filter-bar .filter-btn').forEach((btn) => {
        btn.addEventListener('click', () => {
          document.querySelectorAll('#filter-bar .filter-btn').forEach((b) =>
            b.classList.remove('active')
          );
          btn.classList.add('active');
          activeFilter = btn.getAttribute('data-filter') || 'all';
          render();
        });
      });

      // Fetch latest committed plan.json from GitHub API so recent browser edits appear immediately
      async function fetchLatestFromGitHub() {
        const token = localStorage.getItem(TOKEN_KEY);
        const headers = { Accept: 'application/vnd.github+json' };
        if (token) headers.Authorization = `Bearer ${token}`;

        try {
          const res = await fetch(
            `https://api.github.com/repos/${REPO_OWNER}/${REPO_NAME}/contents/${FILE_PATH}?ref=${BRANCH}`,
            { headers, cache: 'no-store' }
          );
          if (!res.ok) return;
          const payload = await res.json();
          if (payload && payload.content) {
            fileSha = payload.sha;
            const parsed = JSON.parse(decodeUtf8Base64(payload.content));
            committedPlan = parsed;
            if (!isEditing || !isDirty) {
              workingPlan = structuredClone(committedPlan);
              render();
            }
          }
        } catch {
          // Offline or rate-limited: keep build-time SSG fallback silently
        }
      }

      async function verifyRepoWriteAccess(token) {
        const res = await fetch(`https://api.github.com/repos/${REPO_OWNER}/${REPO_NAME}`, {
          headers: {
            Accept: 'application/vnd.github+json',
            Authorization: `Bearer ${token}`,
          },
          cache: 'no-store',
        });
        if (!res.ok) {
          throw new Error('Invalid token or unable to reach GitHub API.');
        }
        const repo = await res.json();
        if (!repo.permissions || !repo.permissions.push) {
          throw new Error(
            `This token does not have write (Contents: Read and write) access to ${REPO_OWNER}/${REPO_NAME}.`
          );
        }
      }

      function enterEditMode() {
        workingPlan = structuredClone(committedPlan);
        isEditing = true;
        markDirty(false);
        render();
      }

      function openAuthModal(errMsg = '') {
        authError.hidden = !errMsg;
        authError.textContent = errMsg;
        tokenInput.value = '';
        authModal.hidden = false;
        setTimeout(() => tokenInput.focus(), 30);
      }

      function closeAuthModal() {
        authModal.hidden = true;
      }

      unlockBtn?.addEventListener('click', async () => {
        const savedToken = localStorage.getItem(TOKEN_KEY);
        if (savedToken) {
          unlockBtn.disabled = true;
          const prevLabel = unlockBtn.querySelector('span');
          if (prevLabel) prevLabel.textContent = 'Verifying...';
          try {
            await verifyRepoWriteAccess(savedToken);
            await fetchLatestFromGitHub();
            enterEditMode();
          } catch {
            localStorage.removeItem(TOKEN_KEY);
            openAuthModal('Saved token expired or revoked. Please enter a new token.');
          } finally {
            unlockBtn.disabled = false;
            if (prevLabel) prevLabel.textContent = 'Edit Plan';
          }
        } else {
          openAuthModal();
        }
      });

      authForm?.addEventListener('submit', async (e) => {
        e.preventDefault();
        const candidate = tokenInput.value.trim();
        if (!candidate) return;

        authSubmitBtn.disabled = true;
        authSubmitBtn.textContent = 'Verifying...';
        authError.hidden = true;

        try {
          await verifyRepoWriteAccess(candidate);
          localStorage.setItem(TOKEN_KEY, candidate);
          closeAuthModal();
          await fetchLatestFromGitHub();
          enterEditMode();
        } catch (err) {
          authError.textContent = err.message || 'Verification failed.';
          authError.hidden = false;
        } finally {
          authSubmitBtn.disabled = false;
          authSubmitBtn.textContent = 'Verify & Unlock';
        }
      });

      authCloseBtn?.addEventListener('click', closeAuthModal);
      authCancelBtn?.addEventListener('click', closeAuthModal);
      authModal?.addEventListener('click', (e) => {
        if (e.target === authModal) closeAuthModal();
      });

      addSectionBtn?.addEventListener('click', () => {
        workingPlan.sections = workingPlan.sections || [];
        workingPlan.sections.unshift({
          id: uid('sec'),
          period: 'NEW PHASE',
          title: 'New Section',
          note: '',
          items: [
            {
              id: uid('item'),
              text: '',
              detail: '',
              tag: '',
              done: false,
            },
          ],
        });
        markDirty();
        render();
      });

      discardBtn?.addEventListener('click', () => {
        if (isDirty && !confirm('Discard all unsaved edits?')) return;
        workingPlan = structuredClone(committedPlan);
        markDirty(false);
        render();
      });

      exitEditBtn?.addEventListener('click', () => {
        if (isDirty && !confirm('You have unsaved changes. Exit without saving?')) return;
        isEditing = false;
        isDirty = false;
        render();
      });

      forgetTokenBtn?.addEventListener('click', () => {
        if (!confirm('Remove saved GitHub token from this browser and exit edit mode?')) return;
        localStorage.removeItem(TOKEN_KEY);
        isEditing = false;
        isDirty = false;
        render();
      });

      async function saveToGitHub() {
        const token = localStorage.getItem(TOKEN_KEY);
        if (!token) {
          openAuthModal('Please unlock with your GitHub token first.');
          return;
        }

        saveBtn.disabled = true;
        saveBtn.textContent = 'Saving...';
        setStatus('saving', 'Committing plan.json to GitHub...');

        try {
          // Always grab latest SHA first to avoid 409 conflicts
          const metaRes = await fetch(
            `https://api.github.com/repos/${REPO_OWNER}/${REPO_NAME}/contents/${FILE_PATH}?ref=${BRANCH}`,
            {
              headers: {
                Accept: 'application/vnd.github+json',
                Authorization: `Bearer ${token}`,
              },
              cache: 'no-store',
            }
          );
          if (metaRes.ok) {
            const meta = await metaRes.json();
            fileSha = meta.sha;
          }

          const today = new Date().toISOString().slice(0, 10);
          workingPlan.updatedAt = today;

          const jsonString = JSON.stringify(workingPlan, null, 2) + '\n';
          const putBody = {
            message: `chore(plan): update plan (${today})`,
            content: encodeUtf8Base64(jsonString),
            branch: BRANCH,
          };
          if (fileSha) putBody.sha = fileSha;

          const putRes = await fetch(
            `https://api.github.com/repos/${REPO_OWNER}/${REPO_NAME}/contents/${FILE_PATH}`,
            {
              method: 'PUT',
              headers: {
                Accept: 'application/vnd.github+json',
                Authorization: `Bearer ${token}`,
                'Content-Type': 'application/json',
              },
              body: JSON.stringify(putBody),
            }
          );

          if (!putRes.ok) {
            const errJson = await putRes.json().catch(() => ({}));
            throw new Error(errJson.message || `GitHub API returned ${putRes.status}`);
          }

          const result = await putRes.json();
          if (result.content && result.content.sha) {
            fileSha = result.content.sha;
          }

          committedPlan = structuredClone(workingPlan);
          isDirty = false;
          if (discardBtn) discardBtn.hidden = true;
          if (updatedAtEl) updatedAtEl.textContent = today;
          setStatus('clean', 'Saved to GitHub ✓ (live now, static rebuild triggered)');
        } catch (err) {
          setStatus('error', `Save failed: ${err.message}`);
        } finally {
          saveBtn.disabled = false;
          saveBtn.textContent = 'Save to GitHub';
        }
      }

      saveBtn?.addEventListener('click', saveToGitHub);

      document.addEventListener('keydown', (e) => {
        if (isEditing && (e.ctrlKey || e.metaKey) && e.key.toLowerCase() === 's') {
          e.preventDefault();
          saveToGitHub();
        }
        if (e.key === 'Escape' && authModal && !authModal.hidden) {
          closeAuthModal();
        }
      });

      window.addEventListener('beforeunload', (e) => {
        if (isEditing && isDirty) {
          e.preventDefault();
          e.returnValue = '';
        }
      });

      // Initial render + live refresh from GitHub
      render();
      fetchLatestFromGitHub();
    })();
  </script>
</BaseLayout>

